{
  "name": "doorboto",
  "version": "3.1.3",
  "description": "This is a server for an access control system",
  "main": "doorboto.js",
  "scripts": {
    "start": ". ./prod.sh && npm exec -- pm2 start ecosystem.config.js",
    "test": "node testing/unit_test.js",
    "i-test": "testing/./run_integration.sh",
    "manual-test": "nodemon doorboto.js",
    "show-logs": "npm exec -- pm2 logs doorboto",
    "shutdown": "npm exec -- pm2 delete doorboto",
    "restart": "npm exec -- pm2 restart ecosystem.config.js --update-env",
    "setup": "./install.sh",
    "postversion": "git add . && git commit && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManchesterMakerspace/doorboto2.git"
  },
  "author": "Manchester Makerspace",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ManchesterMakerspace/doorboto2/issues"
  },
  "homepage": "https://github.com/ManchesterMakerspace/doorboto2#readme",
  "private": true,
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "mongodb": "^6.20.0",
    "node-persist": "^4.0.4",
    "pm2": "^6.0.14",
    "pino": "^9.0.0",
    "serialport": "^13.0.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.2"
  }
}
